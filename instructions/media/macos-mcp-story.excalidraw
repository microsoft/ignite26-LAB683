      "roundness": null,
      "seed": 52,
      "version": 1,
      "versionNonce": 52,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Process names alone can mislead: the hardware-information command resolves to a synthetic stub.\nA current MCP configuration match supports context, not proof of which historical registration was used.",
