    {
      "id": "macos-mcp-story-52",
      "type": "text",
      "x": 62,
      "y": 636,
      "width": 1418.56,
      "height": 110,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
